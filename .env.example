# Rally (Broadcom Agile Central) session auth — used since API key creation
# isn't available on this account. Log in to Rally normally in your browser,
# then pull these two cookie values from DevTools:
#   Chrome: DevTools -> Application -> Storage -> Cookies -> your Rally domain
#   Firefox: DevTools -> Storage -> Cookies -> your Rally domain
# Copy the "ZSESSIONID" and "JSESSIONID" cookie values (not the cookie names).
#
# CAVEAT: these are your live login session tokens, not a durable credential —
# they expire (idle timeout / logout) and you'll need to re-copy fresh values
# when calls start failing with 401/403.
RALLY_ZSESSIONID=
RALLY_JSESSIONID=

# ZDR (Zinnia Jira Cloud) auth — API token, not your password
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
ZDR_JIRA_EMAIL=you@zinnia.com
ZDR_JIRA_API_TOKEN=

# No credentials needed for "Comments Sync Status" — it shells out to the
# `claude` CLI on your PATH, authenticated via `claude /login` (your Claude.ai
# account), not an API key.

# Login gate for the dashboard itself — one shared password for the whole
# team. Leave DRC_ACCESS_PASSWORD blank to disable the login screen entirely
# (local solo use). DRC_SECRET_KEY signs the session cookie; generate one
# with: python3 -c "import secrets; print(secrets.token_hex(32))"
DRC_ACCESS_PASSWORD=
DRC_SECRET_KEY=
